---
import Header from '../components/Header.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import DebtProgress from '../components/DebtProgress.astro';
import DebtPerCitizen from '../components/DebtPerCitizen.astro';
import BudgetDeficit from '../components/BudgetDeficit.astro';
import ExchangeRate from '../components/ExchangeRate.astro';
import DebtSummary from '../components/DebtSummary.astro';
import DebtBreakdown from '../components/DebtBreakdown.astro';
import DebtChart from '../components/DebtChart.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kenya Debt Clock</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
</head>
<body class="bg-gray-900 text-white flex flex-col items-center justify-center min-h-screen p-6 transition-colors duration-300 dark:bg-gray-900 dark:text-white" id="body">
    <div class="text-center w-full max-w-4xl">
        <Header />
        <ThemeToggle />
        <DebtProgress />
        <DebtPerCitizen />
        <BudgetDeficit />
        <ExchangeRate />
        <DebtSummary />
        <DebtBreakdown />
        <DebtChart />
    </div>
    <script type="module" src="/src/scripts/client.js"></script>
</body>
</html>
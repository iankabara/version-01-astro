---
import { formatNumber } from '../scripts/debtLogic.js';
import { getExchangeRateByYear } from '../scripts/data.js';
---

<div class="mb-10 bg-gray-800 p-6 rounded-xl shadow-lg animate__animated animate__fadeInUp">
    <h2 class="text-3xl font-semibold text-green-400 mb-6">KES/USD Exchange Rate (Every 5 Years)</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        <div class="bg-gray-700 p-4 rounded-lg shadow hover:shadow-xl transition-shadow">
            <p class="text-lg font-bold text-gray-200">2000</p>
            <p id="rate-2000" class="text-xl text-gray-300">{getExchangeRateByYear(2000)} KES/USD</p>
        </div>
        <div class="bg-gray-700 p-4 rounded-lg shadow hover:shadow-xl transition-shadow">
            <p class="text-lg font-bold text-gray-200">2005</p>
            <p id="rate-2005" class="text-xl text-gray-300">{getExchangeRateByYear(2005)} KES/USD</p>
        </div>
        <div class="bg-gray-700 p-4 rounded-lg shadow hover:shadow-xl transition-shadow">
            <p class="text-lg font-bold text-gray-200">2010</p>
            <p id="rate-2010" class="text-xl text-gray-300">{getExchangeRateByYear(2010)} KES/USD</p>
        </div>
        <div class="bg-gray-700 p-4 rounded-lg shadow hover:shadow-xl transition-shadow">
            <p class="text-lg font-bold text-gray-200">2015</p>
            <p id="rate-2015" class="text-xl text-gray-300">{getExchangeRateByYear(2015)} KES/USD</p>
        </div>
        <div class="bg-gray-700 p-4 rounded-lg shadow hover:shadow-xl transition-shadow">
            <p class="text-lg font-bold text-gray-200">2020</p>
            <p id="rate-2020" class="text-xl text-gray-300">{getExchangeRateByYear(2020)} KES/USD</p>
        </div>
        <div class="bg-gray-700 p-4 rounded-lg shadow hover:shadow-xl transition-shadow relative">
            <p class="text-lg font-bold text-gray-200">2025 (Live)</p>
            <p id="rate-2025" class="text-xl text-gray-300">{formatNumber(132)} KES/USD</p>
        </div>
    </div>
</div>
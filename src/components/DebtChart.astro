---
import { getDebtByYear } from '../scripts/data.js';
---

<div class="mt-10 chart-container bg-gray-800 p-6 rounded-xl shadow-lg animate__animated animate__fadeInUp">
    <canvas id="debtChart" class="w-full h-96"></canvas>
    <p id="chart-fallback" class="text-gray-400 text-center hidden">Chart failed to load</p>
</div>

<style>
    .chart-container {
        min-height: 400px;
        position: relative;
    }
    #chart-fallback {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }
</style>
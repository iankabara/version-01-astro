---
import { formatNumber } from '../scripts/debtLogic.js';
import { getDebtByYear, getPopulationByYear } from '../scripts/data.js';
---

<div class="mb-10 text-center animate__animated animate__fadeInUp">
    <p class="text-lg text-gray-400 mb-2">
        As of <span id="date" class="font-semibold text-gray-300">{new Date().toISOString().split('T')[0]}</span>
    </p>
    <p id="debt-usd" class="text-2xl font-bold text-gray-200">{formatNumber(getDebtByYear(2024) / 132 / 1e9)} billion USD</p>
    <p id="debt-per-citizen" class="text-2xl font-bold text-gray-200">{formatNumber(getDebtByYear(2024) / getPopulationByYear(2025))} KES per citizen</p>
</div>

<style>
    p {
        line-height: 1.5;
    }
    #debt-usd, #debt-per-citizen {
        color: #10B981;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    }
</style>
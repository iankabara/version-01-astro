---
---

<div class="absolute top-4 right-4">
    <button 
        id="theme-toggle-btn" 
        class="p-3 bg-gray-700 rounded-full hover:bg-gray-600 transition-all duration-200 shadow-md group relative"
        aria-label="Toggle dark/light mode"
    >
        <svg id="sun-icon" class="w-8 h-8 hidden text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        <svg id="moon-icon" class="w-8 h-8 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
        <span class="absolute top-full mt-2 right-0 bg-gray-800 text-white text-sm px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity">
            Toggle Theme
        </span>
    </button>
</div>

<style>
    button:hover {
        transform: scale(1.1);
    }
</style>
---
import { formatNumber } from '../scripts/debtLogic.js';
import { getDebtByYear } from '../scripts/data.js';
---

<div class="mb-10 bg-gray-800 p-6 rounded-xl shadow-lg animate__animated animate__fadeInUp">
    <h2 class="text-3xl font-semibold text-green-400 mb-6">Debt Progress (Every 5 Years)</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        <div class="bg-gray-700 p-4 rounded-lg shadow hover:shadow-xl transition-shadow">
            <p class="text-lg font-bold text-gray-200">2000</p>
            <p id="debt-2000" class="text-xl text-gray-300">{formatNumber(getDebtByYear(2000) / 1e9)} billion KES</p>
            <p class="text-sm text-gray-400">Ext: {formatNumber(getDebtByYear(2000) * 0.5 / 1e9)}B | Int: {formatNumber(getDebtByYear(2000) * 0.5 / 1e9)}B</p>
        </div>
        <div class="bg-gray-700 p-4 rounded-lg shadow hover:shadow-xl transition-shadow">
            <p class="text-lg font-bold text-gray-200">2005</p>
            <p id="debt-2005" class="text-xl text-gray-300">{formatNumber(getDebtByYear(2005) / 1e9)} billion KES</p>
            <p class="text-sm text-gray-400">Ext: {formatNumber(getDebtByYear(2005) * 0.5 / 1e9)}B | Int: {formatNumber(getDebtByYear(2005) * 0.5 / 1e9)}B</p>
        </div>
        <div class="bg-gray-700 p-4 rounded-lg shadow hover:shadow-xl transition-shadow">
            <p class="text-lg font-bold text-gray-200">2010</p>
            <p id="debt-2010" class="text-xl text-gray-300">{formatNumber(getDebtByYear(2010) / 1e12)} trillion KES</p>
            <p class="text-sm text-gray-400">Ext: {formatNumber(getDebtByYear(2010) * 0.5 / 1e12)}T | Int: {formatNumber(getDebtByYear(2010) * 0.5 / 1e12)}T</p>
        </div>
        <div class="bg-gray-700 p-4 rounded-lg shadow hover:shadow-xl transition-shadow">
            <p class="text-lg font-bold text-gray-200">2015</p>
            <p id="debt-2015" class="text-xl text-gray-300">{formatNumber(getDebtByYear(2015) / 1e12)} trillion KES</p>
            <p class="text-sm text-gray-400">Ext: {formatNumber(getDebtByYear(2015) * 0.5 / 1e12)}T | Int: {formatNumber(getDebtByYear(2015) * 0.5 / 1e12)}T</p>
        </div>
        <div class="bg-gray-700 p-4 rounded-lg shadow hover:shadow-xl transition-shadow">
            <p class="text-lg font-bold text-gray-200">2020</p>
            <p id="debt-2020" class="text-xl text-gray-300">{formatNumber(getDebtByYear(2020) / 1e12)} trillion KES</p>
            <p class="text-sm text-gray-400">Ext: {formatNumber(getDebtByYear(2020) * 0.5 / 1e12)}T | Int: {formatNumber(getDebtByYear(2020) * 0.5 / 1e12)}T</p>
        </div>
        <div class="bg-gray-700 p-4 rounded-lg shadow hover:shadow-xl transition-shadow relative">
            <p class="text-lg font-bold text-gray-200">2025 (Live)</p>
            <p id="debt" class="text-xl font-mono text-gray-300">{formatNumber(getDebtByYear(2024) / 1e12)} trillion KES</p>
            <p id="debt-breakdown" class="text-sm text-gray-400">Ext: {formatNumber(getDebtByYear(2024) * 0.5 / 1e12)}T | Int: {formatNumber(getDebtByYear(2024) * 0.5 / 1e12)}T</p>
        </div>
    </div>
</div>

<style>
    .grid > div {
        min-height: 100px;
    }
</style>
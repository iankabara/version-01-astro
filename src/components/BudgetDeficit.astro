---
import { formatNumber } from '../scripts/debtLogic.js';
import { getDeficitByYear } from '../scripts/data.js';
---

<div class="mb-10 bg-gray-800 p-6 rounded-xl shadow-lg animate__animated animate__fadeInUp">
    <h2 class="text-3xl font-semibold text-green-400 mb-6">Budget Deficit (Every 5 Years)</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        <div class="bg-gray-700 p-4 rounded-lg shadow hover:shadow-xl transition-shadow">
            <p class="text-lg font-bold text-gray-200">2000</p>
            <p id="deficit-2000" class="text-xl text-green-400">+{formatNumber(getDeficitByYear(2000) / 1e9)} billion KES</p>
        </div>
        <div class="bg-gray-700 p-4 rounded-lg shadow hover:shadow-xl transition-shadow">
            <p class="text-lg font-bold text-gray-200">2005</p>
            <p id="deficit-2005" class="text-xl text-red-400">-{formatNumber(Math.abs(getDeficitByYear(2005)) / 1e9)} billion KES</p>
        </div>
        <div class="bg-gray-700 p-4 rounded-lg shadow hover:shadow-xl transition-shadow">
            <p class="text-lg font-bold text-gray-200">2010</p>
            <p id="deficit-2010" class="text-xl text-red-400">-{formatNumber(Math.abs(getDeficitByYear(2010)) / 1e9)} billion KES</p>
        </div>
        <div class="bg-gray-700 p-4 rounded-lg shadow hover:shadow-xl transition-shadow">
            <p class="text-lg font-bold text-gray-200">2015</p>
            <p id="deficit-2015" class="text-xl text-red-400">-{formatNumber(Math.abs(getDeficitByYear(2015)) / 1e9)} billion KES</p>
        </div>
        <div class="bg-gray-700 p-4 rounded-lg shadow hover:shadow-xl transition-shadow">
            <p class="text-lg font-bold text-gray-200">2020</p>
            <p id="deficit-2020" class="text-xl text-red-400">-{formatNumber(Math.abs(getDeficitByYear(2020)) / 1e9)} billion KES</p>
        </div>
        <div class="bg-gray-700 p-4 rounded-lg shadow hover:shadow-xl transition-shadow">
            <p class="text-lg font-bold text-gray-200">2025 (Projected)</p>
            <p id="deficit-2025" class="text-xl text-red-400">-{formatNumber(Math.abs(getDeficitByYear(2025)) / 1e9)} billion KES</p>
        </div>
    </div>
</div>